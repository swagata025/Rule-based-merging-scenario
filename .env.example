# ==============================================================================
# Simulation Environment Configuration
# Copy this file to '.env' and update the values for your local environment:
#   copy .env.example .env
# ==============================================================================

# Path to SUMO installation (leave empty if SUMO is already in your system PATH)
# Example for Windows: C:\Program Files (x86)\Eclipse\Sumo
# Example for Linux/macOS: /usr/share/sumo
SUMO_HOME=

# Run SUMO with graphical interface (true) or headless (false)
SUMO_GUI=true

# Path to SUMO configuration file (relative to project root or absolute)
SUMO_CONFIG_PATH=config/merge.config.xml

# Simulation step length in seconds (standard: 0.1)
SIM_STEP_LENGTH=0.1

# Optional: Stop simulation after this many seconds (leave blank to run until all vehicles arrive)
SIM_TIME=

# Path to save simulation telemetry CSV (relative to project root or absolute)
SIM_LOG_PATH=sim_log.csv
